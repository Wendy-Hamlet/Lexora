# Copy to .env and fill in. .env is gitignored.
# Every switch below is read from the process environment; the structured ones
# (storage / LLM / embeddings / API) are also loadable via LexoraConfig
# (src/lexora/config.py). The feature toggles further down are read at point of use.

# --- Storage ---
LEXORA_DB_URL=sqlite:///data/lexora.sqlite
LEXORA_OBJECT_STORE=./data/raw

# --- LLM (any OpenAI-compatible endpoint: OpenAI, vLLM, llama.cpp, Ollama) ---
# Swap the model by changing these three only — no code change. OPENAI_* aliases work too.
LEXORA_LLM_BASE_URL=http://localhost:8000/v1
LEXORA_LLM_API_KEY=not-needed-for-local-vllm
LEXORA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LEXORA_LLM_MAX_TOKENS=512
# LEXORA_LLM_MAX_RETRIES=2
# This endpoint returns empty for json_object mode and wastes ~36s; set 0 to skip it.
# LEXORA_LLM_JSON_MODE=1

# --- Embeddings (optional dense layer; fastembed) ---
LEXORA_EMBEDDING_MODEL=BAAI/bge-m3
# Legacy alias, still honoured (resolve_model_name): LEXORA_EMBED_MODEL
# Device for the embedder: cpu | cuda | auto (default auto).
# LEXORA_EMBED_DEVICE=auto
# ASCII model cache dir — pin this on Windows with a non-ASCII %USERPROFILE%.
# LEXORA_MODEL_CACHE=C:\tmp\lexora_models

# --- OCR (scanned PDFs) ---
# OCR is OFF by default in the library so offline tests never import the backend;
# run_submission.py turns it ON automatically (pass --no-ocr to disable). Set this
# to 1 for any manual recall run, or scanned-only statutes drop to 0 clauses silently.
# LEXORA_OCR=1
# Engine: rapidocr (default, bundled ONNX) | paddleocr (GPU-server path).
# LEXORA_OCR_ENGINE=rapidocr
# GPU preference for OCR: cpu | auto (default auto).
# LEXORA_OCR_GPU=auto
LEXORA_OCR_LANG=eng+jpn+tha+chi_sim
LEXORA_OCR_CITABLE_THRESHOLD=0.85

# --- Mapping retrieval ---
# Fuse the dense channel into mapping clause retrieval (default OFF, BM25-only — see
# pipeline._map_use_dense). Opt in for e.g. cross-lingual docs.
# LEXORA_MAP_DENSE=1

# --- Live crawl (tests + submission) ---
# Required to perform real network crawls; unset = offline (mock transport in tests).
# LEXORA_LIVE=1

# --- API ---
LEXORA_API_HOST=127.0.0.1
LEXORA_API_PORT=8001
